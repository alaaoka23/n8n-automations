        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\"faq\", \"complaint\", \"urgent\", \"unknown\"],\n      \"description\": \"Classify the message as faq, complaint, urgent, or unknown.\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1,\n      \"description\": \"Confidence score from 0 to 1.\"\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\"low\", \"medium\", \"high\"],\n      \"description\": \"Urgency level. Use high for urgent cases.\"\n    },\n    \"needs_human\": {\n      \"type\": \"boolean\",\n      \"description\": \"True when the case must be escalated to a human support agent.\"\n    },\n    \"customer_reply\": {\n      \"type\": \"string\",\n      \"description\": \"A short, polite Arabic reply that will be sent directly to the customer. Do not reveal internal classification or confidence.\"\n    },\n    \"internal_summary\": {\n      \"type\": \"string\",\n      \"description\": \"A concise internal Arabic summary for the support team.\"\n    },\n    \"clarification_question\": {\n      \"type\": \"string\",\n      \"description\": \"One direct Arabic clarification question if the category is unknown or confidence is low. Otherwise return an empty string.\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"confidence\",\n    \"urgency\",\n    \"needs_human\",\n    \"customer_reply\",\n    \"internal_summary\",\n    \"clarification_question\"\n  ],\n  \"additionalProperties\": false\n}\n"
