    {
      "parameters": {
        "jsCode": "const sourceTopic = $json.source_topic?.trim();\n\nif (!sourceTopic) {\n  throw new Error('Source topic is required');\n}\n\nconst brandVoice = $json.brand_voice?.trim() || 'Professional, clear, practical, and friendly';\nconst audience = $json.audience?.trim() || 'Small business owners and marketing teams';\nconst mainGoal = $json.main_goal?.trim() || 'Educate';\nconst createdAt = new Date().toISOString();\n\nconst normalizedSource = sourceTopic.replace(/\\s+/g, ' ').trim();\nconst sourceWordCount = normalizedSource.split(' ').filter(Boolean).length;\nconst sourceIsInsufficient = sourceWordCount < 6 || normalizedSource.length < 45;\nconst sourceQualityReason = sourceIsInsufficient\n  ? 'المصدر قصير جداً أو عام ولا يحتوي على تفاصيل كافية لبناء محتوى موثوق.'\n  : '';\n\nconst tasks = [\n  {\n    channel: 'LinkedIn',\n    format: 'Educational thought-leadership post',\n    instruction: 'Write a professional LinkedIn post with a strong hook, practical insights, short paragraphs, and a discussion question.'\n  },\n  {\n    channel: 'Instagram',\n    format: 'Caption for carousel or reel',\n    instruction: 'Write a concise Arabic caption with a hook, useful value, line breaks, and a clear CTA.'\n  },\n  {\n    channel: 'X',\n    format: 'Short thread',\n    instruction: 'Write a thread of 4 to 6 short posts. The first post must have a strong hook and the final post must have a CTA.'\n  },\n  {\n    channel: 'Newsletter',\n    format: 'Short newsletter outline',\n    instruction: 'Write a subject line, a concise newsletter body, and a practical closing CTA.'\n  }\n];\n\nreturn tasks.map((task, index) => ({\n  json: {\n    created_at: createdAt,\n    content_id: `CNT-${Date.now()}-${index + 1}`,\n    source_topic: sourceTopic,\n    brand_voice: brandVoice,\n    audience,\n    main_goal: mainGoal,\n    source_is_insufficient: sourceIsInsufficient,\n    source_quality_reason: sourceQualityReason,\n    source_word_count: sourceWordCount,\n    ...task\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "7257e62b-8bf3-4bc3-8a2f-59bf49ffbb81",
      "name": "creat content task"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        448,
        0
      ],
      "id": "c3581fd7-21ae-4545-a4a6-142ddca6463b",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Source topic:\n{{ $json.source_topic }}\n\nTarget channel: {{ $json.channel }}\nContent format: {{ $json.format }}\nTarget audience: {{ $json.audience }}\nMain goal: {{ $json.main_goal }}\nBrand voice: {{ $json.brand_voice }}\nSource pre-check: {{ $json.source_is_insufficient ? 'INSUFFICIENT' : 'SUFFICIENT' }}\nChannel-specific instruction:\n{{ $json.instruction }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are a Senior Arabic Content Strategist for a marketing team. Your primary objective is to create one high-quality, engaging, and channel-tailored piece of Arabic content based STRICTLY on the provided source topic and task brief.\n\n### SYSTEM INSTRUCTIONS & BEHAVIOR RULES:\n\n1. SOURCE TRUTH & ANTI-HALLUCINATION:\n   - Base your content ONLY on the provided source topic and brief.\n   - Do NOT invent statistics, client cases, testimonials, fake URLs, unannounced product features, or company facts.\n   - Strictly avoid exaggerated claims, manipulative language, or unsupported professional advice (medical, legal, financial).\n\n2. LANGUAGE & BRAND VOICE:\n   - Write cleanly and effectively in Arabic (or Egyptian Colloquial Arabic if specifically requested in the brief).\n   - Tailor the tone, length, and format precisely to the specified channel (e.g., LinkedIn, Instagram, X/Twitter, Blog).\n\n3. HASHTAG RULES:\n   - Include 3 to 6 highly relevant Arabic hashtags ONLY if the target channel supports them (e.g., Instagram, LinkedIn, X).\n   - Return an empty array `[]` if hashtags are not appropriate for the requested format/channel.\n\n4. QUALITY ASSURANCE & STATUS LOGIC:\n   - Set quality_status to \"ready\": If the input brief is complete, factual, and the generated content complies 100% with all guidelines.\n   - Set quality_status to \"needs_review\": If the source brief is vague, too brief to create meaningful content, missing essential facts, or risks making an unsupported claim.\n   - When quality_status is \"needs_review\", explain the exact missing info in qa_reason while still providing a safe, conservative draft in content.\n   - If Source pre-check is INSUFFICIENT, you MUST set quality_status to \"needs_review\". Do not set it to \"ready\", even if you can write a generic draft.\n\n### Return only the required structured output."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        672,
        16
      ],
      "id": "69f6b0db-475d-43db-9f38-8fbd388a6302",
      "name": "AI Agent",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"content\": {\n      \"type\": \"string\",\n      \"description\": \"The complete Arabic content for the requested channel.\"\n    },\n    \"hashtags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Three to six relevant hashtags, or an empty array if not suitable.\"\n    },\n    \"cta\": {\n      \"type\": \"string\",\n      \"description\": \"A short Arabic call to action.\"\n    },\n    \"quality_status\": {\n      \"type\": \"string\",\n      \"enum\": [\"ready\", \"needs_review\"],\n      \"description\": \"Whether the content is ready for internal review or needs additional human review.\"\n    },\n    \"qa_reason\": {\n      \"type\": \"string\",\n      \"description\": \"Short Arabic reason for the quality decision.\"\n    }\n  },\n  \"required\": [\n    \"content\",\n    \"hashtags\",\n    \"cta\",\n    \"quality_status\",\n    \"qa_reason\"\n  ],\n  \"additionalProperties\": false\n}"
      },
