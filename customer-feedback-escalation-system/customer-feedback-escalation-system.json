        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\"positive\", \"neutral\", \"negative\"],\n      \"description\": \"Overall customer sentiment.\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\"low\", \"medium\", \"high\"],\n      \"description\": \"Operational priority for the support team.\"\n    },\n    \"needs_follow_up\": {\n      \"type\": \"boolean\",\n      \"description\": \"True when a human should review or contact the customer.\"\n    },\n    \"topics\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"One or more topics, for example delivery, payment, product_quality, refund, account_access, praise.\"\n    },\n    \"internal_summary\": {\n      \"type\": \"string\",\n      \"description\": \"A concise Arabic summary for the support team.\"\n    },\n    \"suggested_reply\": {\n      \"type\": \"string\",\n      \"description\": \"A short, polite and professional Arabic reply for the customer.\"\n    }\n  },\n  \"required\": [\n    \"sentiment\",\n    \"priority\",\n    \"needs_follow_up\",\n    \"topics\",\n    \"internal_summary\",\n    \"suggested_reply\"\n  ],\n  \"additionalProperties\": false\n}"
