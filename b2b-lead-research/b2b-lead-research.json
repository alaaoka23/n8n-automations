    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json;\n\nconst leadId = String(input.lead_id ?? '').trim();\nconst companyName = String(input.company_name ?? '').trim();\nconst websiteUrl = String(input.website_url ?? '').trim();\nconst contactName = String(input.contact_name ?? '').trim();\nconst contactEmail = String(input.contact_email ?? '').trim().toLowerCase();\nconst industry = String(input.industry ?? '').trim();\nconst companySize = String(input.company_size ?? '').trim();\n\nconst urlIsValid = /^https?:\\/\\/[^\\s]+$/i.test(websiteUrl );\n\nconst emailIsValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(contactEmail);\nconst requiredFieldsPresent = Boolean(leadId && companyName && websiteUrl);\nconst isValidLead = requiredFieldsPresent && urlIsValid && emailIsValid;\n\n\nreturn {\n  json: {\n    row_number: input.row_number,\n    lead_id: leadId,\n    company_name: companyName,\n    website_url: websiteUrl,\n    contact_name: contactName,\n    contact_email: contactEmail,\n    industry: industry || 'Unknown',\n    company_size: companySize || 'Unknown',\n    url_is_valid: urlIsValid,\n    email_is_valid: emailIsValid,\n    required_fields_present: requiredFieldsPresent,\n    is_valid_lead: isValidLead,\n    validation_reason: isValidLead\n      ? 'Valid lead for research'\n      : 'Missing required fields or invalid website URL',\n    original_status: input.status || 'new',\n    received_at: new Date().toISOString()\n  }\n};\n"
      },
