      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\"high\", \"medium\", \"low\"]\n    },\n    \"fit_score\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 100\n    },\n    \"research_confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\"high\", \"medium\", \"low\"]\n    },\n    \"fit_reasons\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    },\n    \"personalization_angle\": {\n      \"type\": \"string\"\n    },\n    \"email_subject\": {\n      \"type\": \"string\"\n    },\n    \"email_body\": {\n      \"type\": \"string\"\n    },\n    \"risk_flags\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    },\n    \"needs_review\": {\n      \"type\": \"boolean\"\n    },\n    \"handoff_reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"priority\",\n    \"fit_score\",\n    \"research_confidence\",\n    \"fit_reasons\",\n    \"personalization_angle\",\n    \"email_subject\",\n    \"email_body\",\n    \"risk_flags\",\n    \"needs_review\",\n    \"handoff_reason\"\n  ]\n}"
