      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const current = $json;\n\nlet errorText = current.error?.message\n  || current.message\n  || current.error\n  || 'AI Agent or parser failed';\n\nif (typeof errorText === 'object') {\n  errorText = JSON.stringify(errorText);\n}\n\nlet original = {};\n\ntry {\n  original = $('normalize company research').item.json || {};\n} catch (error) {\n  original = {};\n}\n\nreturn {\n  json: {\n    exception_id: `AI-ERR-${Date.now()}`,\n    lead_id: original.lead_id || current.lead_id || 'unknown',\n    company_name: original.company_name || current.company_name || 'unknown',\n    stage: 'ai_scoring',\n    error_message: String(errorText),\n    source_url: original.website_url || current.website_url || '',\n    created_at: new Date().toISOString(),\n    action_taken: 'No Gmail draft created',\n    status: 'ai_failed'\n  }\n};\n"
      },
