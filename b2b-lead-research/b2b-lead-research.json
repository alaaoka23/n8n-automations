    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const errorText = $json.error?.message || $json.message || 'Microlink request failed';\n\nreturn {\n  json: {\n    exception_id: `RESEARCH-ERR-${Date.now(  )}`,\n    lead_id: $('Code in JavaScript').item.json.lead_id,\n    company_name: $('Code in JavaScript').item.json.company_name,\n    stage: 'microlink_api',\n    error_message: errorText,\n    source_url: $('Code in JavaScript').item.json.website_url,\n    created_at: new Date().toISOString(),\n    action_taken: 'Skipped AI scoring and logged API failure',\n    status: 'research_failed'\n  }\n};"
      },
      "id": "7604c139-5392-483e-82d8-3295a97d7d23",
      "name": "prepare research exception",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        688
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst original = $('Code in JavaScript').item.json;\nconst data = response.data || {};\n\nconst researchStatus = response.status === 'success' && data.title\n  ? 'success'\n  : 'insufficient_data';\n\nreturn {\n  json: {\n    lead_id: original.lead_id,\n    company_name: original.company_name,\n    website_url: original.website_url,\n    contact_name: original.contact_name,\n    contact_email: original.contact_email,\n    industry: original.industry,\n    company_size: original.company_size,\n    page_title: data.title || '',\n    page_description: data.description || '',\n    page_language: data.lang || '',\n    page_publisher: data.publisher || '',\n    canonical_url: data.url || original.website_url,\n    logo_url: data.logo?.url || '',\n    research_status: researchStatus,\n    research_source: 'Microlink metadata API',\n    researched_at: new Date().toISOString()\n  }\n};"
      },
      "id": "5245f3ce-5053-4146-9d3d-750804dac472",
      "name": "normalize company research",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        208
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this B2B lead using only the verified company metadata below.\n\nLead ID: {{ $json.lead_id }}\nCompany: {{ $json.company_name }}\nWebsite: {{ $json.website_url }}\nContact name: {{ $json.contact_name }}\nContact email: {{ $json.contact_email }}\nIndustry: {{ $json.industry }}\nCompany size: {{ $json.company_size }}\nPage title: {{ $json.page_title }}\nPage description: {{ $json.page_description }}\nPublisher: {{ $json.page_publisher }}\nResearch status: {{ $json.research_status }}\n\nEvaluate whether this company could reasonably benefit from AI automation services.\nCreate an Arabic or English outreach draft based on the available evidence, but do not invent company facts, budgets, pain points, clients, or technologies.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are a careful B2B lead-research and outreach assistant.\n\nYour job is to evaluate a potential business lead using only the verified metadata provided in the user message.\n\nRules:\n1. Do not invent facts about the company.\n2. Do not claim that the company uses a technology unless the input explicitly says so.\n3. If the website data is missing or weak, lower research_confidence and set needs_review to true.\n4. Classify priority as high only when the evidence shows a clear fit and the outreach can be specific without guessing.\n5. Classify priority as medium when there may be a fit but a human should review the assumptions.\n6. Classify priority as low when there is weak evidence, no clear business fit, or insufficient information.\n7. Never send an email. Create a draft only; a human must review it before any external communication.\n8. Do not include sensitive personal data in the email.\n9. Keep the email short, respectful, and non-spammy.\n10. Return only the required structured output."
        }
      },
